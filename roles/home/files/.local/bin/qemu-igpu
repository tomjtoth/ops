#!/bin/bash


__backlight(){
    local BL_LEVEL BL_PATH=(
        /sys/class/backlight/intel_backlight/brightness 
        /tmp/qemu-igpu-pt-backlight
        /sys/class/backlight/intel_backlight/max_brightness 
    )

    if [ -e ${BL_PATH[0]} ]; then
        BL_LEVEL=$(cat ${BL_PATH[0]})
    elif [ -e ${BL_PATH[1]} ]; then
        BL_LEVEL=$(cat ${BL_PATH[1]})
    else
        BL_LEVEL=$(cat ${BL_PATH[2]})
    fi

    if [ $1 = store ]; then
        echo $BL_LEVEL > ${BL_PATH[1]}
    else
        echo $BL_LEVEL | sudo tee ${BL_PATH[0]}
    fi
}

__bind_tty() {
    for i in /sys/class/vtconsole/*/bind; do
        echo $1 | sudo tee "$i"
    done
}

unbind() {
    local ids=($( lspci -nnkD | \
            grep "VGA compatible controller" -A 3 | \
            grep -oE '^\S+|8086:....'))

    __backlight store

    sudo systemctl stop display-manager.service

    __bind_tty 0

    sudo modprobe -rv xe || true

    echo ${ids[0]} | sudo tee /sys/module/i915/drivers/pci:i915/unbind
    # killall pipewire || true

    sleep 2

    # sudo rmmod snd_sof
    sudo modprobe -rv i915

    # Load vfio
    sudo modprobe vfio-pci ids="${ids[1]}"

    lspci -nnkd ${ids[1]}

    # needed for mounting the vfio device
    SUDO=sudo

    # dumped host bios: sudo flashrom -p internal -r host_bios.bin
    # uefitool host_bios.bin # CTRL+F IntelGopDriver -> PE32 image -> Extract body -> below file
    local INTEL_GOP=~/intel_gop.efi

    # this was not needed (?)
    # sudo cp /sys/kernel/debug/dri/0/i915_vbt ~/intel_vbt.bin
    #local INTEL_VBT=~/intel_vbt.bin

    VM_VIDEO="
        -device ramfb -vga none -vnc 0.0.0.0:0
        `# -device vfio-pci-igd-lpc-bridge,id=lpc0,bus=pcie.0,addr=1f.0`
        -device vfio-pci,host=${ids[0]},bus=pcie.0,addr=0x2,x-igd-opregion=on,x-igd-gms=4,romfile=$INTEL_GOP
    "
}

rebind() {
    sudo modprobe -rv vfio_pci

    # modprobe snd_hda_intel
    sudo modprobe i915

    __bind_tty 1

    sudo systemctl start display-manager.service

    __backlight restore
}

# https://www.reddit.com/r/VFIO/comments/12pxo25/full_passthrough_of_12th_gen_iris_xe_seems/

# this should require ACRN project's patched edk2, but I failed to build it myself
# https://projectacrn.github.io/3.3/tutorials/gpu-passthru.html
# https://github.com/Kethen/edk2-build-intel-gop

# NOT working on Thinkpad T14 Gen 2 with i5-1135G7
sriov() {
    if [ ! -d /dev/kvmfr0 ]; then
        sudo modprobe kvmfr static_size_mb=32
        sudo chown root:kvm /dev/kvmfr0
        sudo chmod 0660 /dev/kvmfr0

        echo 0 | sudo tee /sys/bus/pci/devices/0000:00:02.0/sriov_drivers_autoprobe
        echo 1 | sudo tee /sys/bus/pci/devices/0000:00:02.0/sriov_numvfs

        lspci -nnk -s 00:02

        sudo modprobe vfio-pci
        echo vfio-pci | sudo tee /sys/bus/pci/devices/0000:00:02.1/driver_override
        echo 0000:00:02.1 | sudo tee /sys/bus/pci/drivers_probe

        lspci -nnk -s 00:02
    fi


    SUDO=sudo

    VM_VIDEO="
        -vga none
        -device ramfb
        -display gtk,gl=on
        -device vfio-pci,host=${VFIO_PCI}
        -object memory-backend-file,id=looking-glass,mem-path=/dev/kvmfr0,size=32M,share=yes
        -device ivshmem-plain,memdev=looking-glass
    "

}

# NOT working on Acer Aspire E 14 with i3-7130U
gvt() {
    local GVT_PCI=/sys/devices/pci0000\:00/0000\:00\:02.0
    local GVT_UUID=$(uuidgen)

    # cleanup any leftovers
    for d in /sys/bus/mdev/devies/*; do
        echo 1 | sudo tee "$d/remove"
    done

    sudo modprobe kvmgt vfio-iommu-type1 mdev

    echo $GVT_UUID | sudo tee $GVT_PCI/mdev_supported_types/i915-GVTg_V5_4/create

    SUDO=sudo
    VM_VIDEO="
        -monitor stdio
        -vga none
        -display gtk,gl=on
        -device ramfb
        -device vfio-pci,sysfsdev=/sys/bus/mdev/devices/$GVT_UUID,display=on,x-igd-opregion=on,driver=vfio-pci-nohotplug
    "
}
